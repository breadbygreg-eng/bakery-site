{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "redirects": [
    {
      "source": "/VIP",
      "destination": "/vip",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
  "crons": [
    {
      "path": "/tasks/monthly-billing-blast",
      "schedule": "0 12 1 * *"
    }
  ]
}
}
